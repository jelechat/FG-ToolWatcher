{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/preload/index.d.ts",
    "src/shared/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx"
  ]
}
